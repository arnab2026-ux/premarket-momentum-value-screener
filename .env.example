# Market data
DATA_PROVIDER=fmp                # fmp | mock
FMP_API_KEY=

# Supabase (service role key: server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Screener <screener@yourdomain.com>"
# Recipient is in config/screener.config.ts (or admin page); this env var overrides it if set
REPORT_RECIPIENT=

# Security
CRON_SECRET=                     # Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
ADMIN_USER=admin
ADMIN_PASSWORD=
